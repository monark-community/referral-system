# Copy to .env.sepolia. Never commit the populated file.
POSTGRES_USER=reffinity
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=reffinity

JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://app.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Use a private provider credential for the API and a restricted browser-safe
# credential for NEXT_PUBLIC_RPC_URL. Anything NEXT_PUBLIC is visible to users.
RPC_URL=https://sepolia.example-provider.invalid/server-key
RPC_WEBSOCKET_URL=wss://sepolia.example-provider.invalid/server-key
NEXT_PUBLIC_RPC_URL=https://sepolia.example-provider.invalid/browser-key
REFERRAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
