# .env.example - Used by docker to correctly pass to the various tasks
JWT_SECRET=change-me-in-production
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Local blockchain defaults. The Sepolia production stack uses .env.sepolia.
BLOCKCHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
RPC_WEBSOCKET_URL=ws://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
REFERRAL_CONTRACT_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
